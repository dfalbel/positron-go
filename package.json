{
	"name": "positron-go",
	"displayName": "Positron Go",
	"description": "Go language runtime support for Positron using the gonb kernel",
	"version": "0.1.0",
	"publisher": "dfalbel",
	"repository": {
		"type": "git",
		"url": "https://github.com/posit-dev/positron-go"
	},
	"engines": {
		"vscode": "^1.100.0",
		"positron": "^2025.6.x"
	},
	"categories": [
		"Programming Languages"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "positronGo.runGoSample",
				"title": "Run Go sample in Positron"
			}
		],
		"configuration": {
			"title": "Positron Go",
			"properties": {
				"positronGo.kernelSpecPath": {
					"type": "string",
					"default": "",
					"scope": "application",
					"description": "Absolute path to the gonb kernel.json file. Leave empty to search the default Jupyter kernel locations."
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"lint": "eslint",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile && npm run lint",
		"test": "vscode-test"
	},
	"devDependencies": {
		"@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "^20",
		"@types/sinon": "^17.0.4",
		"@types/vscode": "^1.100.0",
		"@vscode/test-cli": "^0.0.11",
		"@vscode/test-electron": "^2.5.2",
		"eslint": "^9.13.0",
		"glob": "^11.0.0",
		"mocha": "^11.6.0",
		"sinon": "^20.0.0",
		"typescript": "^5.8.2",
		"typescript-eslint": "^8.26.0"
	},
	"dependencies": {
		"@posit-dev/positron": "^0.1.3",
		"uuid": "^13.0.0"
	}
}
